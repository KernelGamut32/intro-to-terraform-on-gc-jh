#!/bin/bash
# ledgerlite startup script. Rendered by Terraform templatefile() at plan
# time. Values written as dollar-brace names are template variables. Do not edit this file on
# the instance; change the Terraform inputs and apply instead.
set -euo pipefail

APP_DIR=/opt/ledgerlite
mkdir -p "$APP_DIR"

META=http://metadata.google.internal/computeMetadata/v1/instance
INSTANCE_NAME=$(curl -sf -H "Metadata-Flavor: Google" "$META/name")
INSTANCE_ZONE=$(curl -sf -H "Metadata-Flavor: Google" "$META/zone" | awk -F/ '{print $NF}')
INTERNAL_IP=$(curl -sf -H "Metadata-Flavor: Google" "$META/network-interfaces/0/ip")
RENDERED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)

cat > "$APP_DIR/index.html" <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>${app_name} ${app_version}</title>
<style>
  body { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0; margin: 0; }
  main { max-width: 720px; margin: 8vh auto; padding: 2rem; background: #1e293b; border-radius: 12px; }
  h1 { margin-top: 0; font-weight: 600; }
  .tag { display: inline-block; padding: .2rem .6rem; border-radius: 999px; background: #0ea5e9; color: #0f172a; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  td { padding: .5rem .25rem; border-bottom: 1px solid #334155; }
  td:first-child { color: #94a3b8; width: 40%; }
</style>
</head>
<body>
<main>
  <span class="tag">${environment}</span>
  <h1>${app_name} is running</h1>
  <p>This page was built from Terraform inputs by the startup template.</p>
  <table>
    <tr><td>Application version</td><td>${app_version}</td></tr>
    <tr><td>Team</td><td>${team}</td></tr>
    <tr><td>Instance name</td><td>$INSTANCE_NAME</td></tr>
    <tr><td>Zone</td><td>$INSTANCE_ZONE</td></tr>
    <tr><td>Internal IP</td><td>$INTERNAL_IP</td></tr>
    <tr><td>Listening port</td><td>${app_port}</td></tr>
    <tr><td>Rendered at (UTC)</td><td>$RENDERED_AT</td></tr>
  </table>
</main>
</body>
</html>
HTML

cat > /etc/systemd/system/ledgerlite.service <<UNIT
[Unit]
Description=ledgerlite demo web application
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=$APP_DIR
ExecStart=/usr/bin/python3 -m http.server ${app_port} --bind 0.0.0.0
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

if command -v python3 >/dev/null 2>&1; then
  systemctl daemon-reload
  systemctl enable --now ledgerlite
  echo "ledgerlite ${app_version} (${environment}) listening on port ${app_port}"
else
  echo "ledgerlite ${app_version} (${environment}): python3 not found; page written to $APP_DIR/index.html only"
fi

# Echo the rendered values to the serial console so they are visible with
# gcloud compute instances get-serial-port-output.
echo "ledgerlite-render app=${app_name} version=${app_version} env=${environment} team=${team} port=${app_port} instance=$INSTANCE_NAME zone=$INSTANCE_ZONE ip=$INTERNAL_IP"
