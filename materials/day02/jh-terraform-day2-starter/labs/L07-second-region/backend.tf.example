# Copy to backend.tf, then set both values.
#
# bucket: the same state bucket as your primary root.
# prefix: your primary prefix followed by /us-east1, for example
#         labs/lab-07/us-east1. A distinct prefix means a distinct state.
#
# Backend blocks cannot use variables, so the values are literal.

terraform {
  backend "gcs" {
    bucket = "REPLACE_WITH_YOUR_STATE_BUCKET"
    prefix = "labs/REPLACE_WITH_YOUR_LAB_ID/us-east1"
  }
}
